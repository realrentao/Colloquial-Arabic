        {"ar": "حِجْرَةٌ وَاسِعَةٌ", "zh": "一间宽敞的房间。", "roman": "Híjra wáasi9a"},
        {"ar": "الْحِجْرَةُ الْوَاسِعَةُ", "zh": "那间宽敞的房间。", "roman": "il-Híjra l-wáasi9a"},
