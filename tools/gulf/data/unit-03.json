        {
          "speaker_zh": "乙",
          "ar": "أَي نَعَمْ.",
          "zh": "有的，是的。",
          "roman": "ay ná9am."
        },
        {
          "speaker_zh": "甲",
          "ar": "چَمْ وَاحِدٍ فِي؟",
          "zh": "有多少（人）？",
          "roman": "cham wáaHid fii?"
