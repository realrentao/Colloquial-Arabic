  "grammar": [
    {
      "title_zh": "询问数量：چَمْ / كَمْ 与“有／没有”",
      "body_zh": "海湾语里“多少”用 چَمْ（cham，各地通用）或其变体 كَمْ（kam），后面直接跟单数名词——但像 الحَلِيب、الْجِبْن、النَّاس 这类集合名词没有单数形式，仍按原样使用。问“有没有／有多少”时，把“有”的词放进句子：巴林多用 هَسْتَ（hast，现略旧式），科威特用 أَكُو（aku），各地通用 فَي（fii）。三种说法常与 چَمْ 搭配提问。回答“没有”分别用 مَا هَسْتَ、مَاكُو、مَا فِي。",
      "examples": [
        {"ar": "چَمْ حَلِيبٌ؟", "zh": "有多少牛奶？", "roman": "kam/chám Halíib?"},
        {"ar": "چَمْ رَيَّالٌ هَسْتَ؟", "zh": "有多少男人？", "roman": "kam/chám rayyáal?"},
        {"ar": "كَمْ سَيَّارَةٌ هَسْتَ؟", "zh": "有几辆汽车？", "roman": "kám sayyáara hást?"},
        {"ar": "أَكُو كَمْ قِسْمٍ؟", "zh": "有多少个部门？", "roman": "áku kam qisim?"}
      ],
      "tip_zh": "چَمْ 后接单数名词（如 رَيَّالٌ“男人”、كَيْلُو“公斤”），不要误用复数。"
    },
    {
      "title_zh": "否定存在：مَا هَسْتَ / مَاكُو / مَا فِي / مَا مِشْ / مَا شَيْء",
      "body_zh": "要表达“一个也没有”，除 مَا هَسْتَ、مَاكُو、مَا فِي 外，巴林还说 مَا مِشْ（maa mish），阿曼说 مَا شَيْء（maa shay），最通用、最少地方色彩的是 مَا فِي。这些短语既可放在名词前，也可放在名词后，意思不变。注意关键区别：چَمْ 后接单数名词，而“没有”之后的名词要用复数——若用单数，意思就变成“连一个……都没有”。",
      "examples": [
        {"ar": "رَيَّايِيلُ مَا فِي.", "zh": "没有男人。（复数）", "roman": "rayaayíil máa fii"},
        {"ar": "مَاكُو بَطَالَاتٌ.", "zh": "没有瓶子。（复数）", "roman": "máaku glaasáat"},
        {"ar": "مَاكُو جِلَاسٌ.", "zh": "连一个杯子都没有。（单数）", "roman": "máaku gláas"},
        {"ar": "عَامِلٌ مَا شَيْء.", "zh": "连一个工人都没有。（单数）", "roman": "9aamil maa shay"}
      ],
      "tip_zh": "回答里名词用复数＝“没有任何……”；用单数则强调“一个都没有”，语气更强。"
    },
    {
      "title_zh": "询问价格：بِچَمْ",
      "body_zh": "问价钱不能只用 چَمْ，要说 بِچَمْ（bi cham，字面义“以多少／卖多少”），结构为“商品 + بِچَمْ + 量词名词”。例如“面包多少钱”“一公斤肉多少钱”“一瓶牛奶多少钱”。这里的 بِـ 是“以……价格”的意思。",
      "examples": [
        {"ar": "الْخُبْزُ بِچَمْ؟", "zh": "面包多少钱？", "roman": "il-xúbuz bi chám?"},
        {"ar": "اللَّحْمُ بِچَمِ الْكَيْلُو؟", "zh": "一公斤肉多少钱？", "roman": "il-láHam bi chám il-káylo?"},
        {"ar": "الْحَلِيبُ بِچَمِ الْبُطْلُ؟", "zh": "一瓶牛奶多少钱？", "roman": "il-Halíib bi chám il-búTil?"},
        {"ar": "السَّمِينُ بِچَمِ الْخِيَاشَةُ؟", "zh": "一袋水泥多少钱？", "roman": "is-smíit bi chám il-xáysha?"}
      ],
      "tip_zh": "记住固定搭配：بِچَمْ + 计量单位（كَيْلُو／بُطْل／خِيَاشَة…）。"
    },
    {
      "title_zh": "数字 1–10 的阴阳两性及其搭配",
      "body_zh": "海湾阿拉伯语中 1–10 各有阳、阴两式。奇妙的是：数词要与被数名词“性别相反”——数阳性名词用阴性数词，数阴性名词用阳性数词。判定名词阴性可看意义（如 البِنْت“女孩”、الْأُخْت“姐妹”、الْأُمّ“母亲”），也可看词尾 -a（如 الشَّرِكَة“公司”、السَّيَّارَة“汽车”），还有少数需硬记的词如 الرِّيح“风”。“一”和“二”更特殊：要放在名词之后，且与名词同性；“二”通常用双数（وَلَدَانِ、بِنْتَانِ）表达。若阳性复数以元音开头，阴性数词中“隐藏的 t”须读出，如 سِتَّةُ أَوْلَادٍ。数字也常单独使用，省略后面的名词。",
      "examples": [
        {"ar": "خَمْسُ سَيَّارَاتٍ.", "zh": "五辆汽车。（阳数配阴名）", "roman": "xáms sayyaaráat"},
        {"ar": "خَمْسَةُ رَيَّايِيلَ.", "zh": "五个男人。（阴数配阳名）", "roman": "xámsa rayaayíil"},
        {"ar": "سِتَّةُ أَوْلَادٍ.", "zh": "六个男孩。（读出隐藏的 t）", "roman": "síttat awláad"},
        {"ar": "وَلَدٌ وَاحِدٌ / بِنْتٌ وَاحِدَةٌ.", "zh": "一个男孩／一个女孩。（“一”后置且同性）", "roman": "wálad wáaHid / bínt wáHda"}
      ],
      "tip_zh": "口诀：数词与名词“性别相反”（一、二除外）；“一、二”后置且“性别相同”。"
    },
    {
      "title_zh": "问候与告别",
      "body_zh": "海湾阿拉伯语的问候语比汉语、英语都更丰富，并随场合正式程度而变化。最正式的是进入房间或办公室时说 السَّلَامُ عَلَيْكُمْ，对方回 وَعَلَيْكُمُ السَّلَامُ。朋友之间常说 أَهْلًا 或 أَهْلًا وَسَهْلًا，可回 أَهْلًا بِكَ（对男）／أَهْلًا بِچِ（对女）、أَهْلًا مَرْحَبًا，最具海湾味道的是 يَا هَلَا。寒暄之后接着问健康：چَيْفُ الْحَالِ、چَيْفُ حَالِكَ（对男）／چَيْفُ حَالِچِ（对女）、شْلُونَكَ（对男）／شْلُونَچِ（对女），可答 الْحَمْدُ لِلَّهِ、بِخَيْرٍ、زَيْنٌ，并说 اللهُ يُسَلِّمُكَ（对男）／اللهُ يُسَلِّمُچِ（对女）回敬，一来一往可以持续许久。告别时说 فِي أَمَانِ اللهِ，对方回 مَعَ السَّلَامَةِ。",
      "examples": [
        {"ar": "السَّلَامُ عَلَيْكُمْ — وَعَلَيْكُمُ السَّلَامُ", "zh": "愿平安降临于你们——也愿平安降临于你们", "roman": "is-saláam 9aláykum — uu 9aláykum is-saláam"},
        {"ar": "چَيْفُ حَالِكَ؟ — الْحَمْدُ لِلَّهِ، بِخَيْرٍ!", "zh": "你好吗？（对男）——感赞真主，很好！", "roman": "chayf Háalik? — il Hámdu lilláah, bi xayr!"},
        {"ar": "شْلُونَچِ؟ — زَيْنٌ، اللهُ يُسَلِّمُكَ.", "zh": "你好吗？（对女）——很好，愿真主保佑你。", "roman": "shlóonach? — zayn, állah yisálmik."},
        {"ar": "فِي أَمَانِ اللهِ — مَعَ السَّلَامَةِ.", "zh": "再会——一路平安。", "roman": "fi amáan illáah — ma9a s-saláama"}
      ],
      "tip_zh": "对男性用 -كَ/-كَ，对女性用 -چِ/-چِ，问答双方都要随对象的性别选择正确词尾。"
    }
  ],
  "exercises": [
    {
      "title_zh": "练习一 · 用“没有”完成问答",
      "prompt_zh": "仿照例句，用 مَا هَسْتَ／مَا فِي／مَا مِشْ／مَا شَيْء 或 مَاكُو 翻译下列简短对话，表示“一个也没有”。",
      "items": [
        {"q_zh": "有多少笔记本？——根本没有笔记本。", "answer_ar": "چَمْ دَفْتَرٌ هَسْتَ؟ — مَا فِي دَفَاتِرَ بِالْمَرَّةِ.", "answer_zh": "问句用单数 دَفْتَرٌ，答句用复数 دَفَاتِرَ;"},
